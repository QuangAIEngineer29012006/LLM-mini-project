# Chọn gemini và điền key để gọi thật; fake chạy offline, không tốn API.
LLM_PROVIDER=fake
LLM_MODEL_ID=gemini-3.5-flash-lite
GEMINI_API_KEY=
LLM_TIMEOUT_SECONDS=12
LLM_MAX_RETRIES=0
LLM_DAILY_REQUEST_LIMIT=500
# LLM_USAGE_DB_PATH=database/data/llm_usage.db

SESSION_TTL_SECONDS=86400
API_REQUESTS_PER_MINUTE=120
CHAT_REQUESTS_PER_MINUTE=10
SESSION_REQUESTS_PER_MINUTE=20
# SHOP_DB_PATH=database/data/shop.db

# RAG: gemini = Gemini embedding (cần key, tốn quota, index artifacts/index_manifest.json);
# fake = embedding băm offline (index artifacts/index_manifest_fake.json). Index cả hai đã có sẵn.
RAG_EMBEDDING_PROVIDER=fake
RAG_EMBEDDING_MODEL=gemini-embedding-001
RAG_EMBEDDING_DIMENSION=768
# RAG_INDEX_POINTER=artifacts/index_manifest.json
# Khóa mở phiên staff/admin mô phỏng (để trống = tắt). Chỉ dùng cho demo.
DEMO_STAFF_KEY=
DEMO_ADMIN_KEY=
